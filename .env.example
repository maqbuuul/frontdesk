# --- Which calendar sits behind the agent -----------------------------------
# mock (default when no keys: zero-cost demo) | calcom | gohighlevel
# CALENDAR_PROVIDER=mock
CALENDAR_PROVIDER=

CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
# CALCOM_API_URL=https://api.cal.com/v2
# CALCOM_API_VERSION=2024-09-04

# Only needed when CALENDAR_PROVIDER=gohighlevel
GHL_API_TOKEN=
GHL_CALENDAR_ID=
GHL_LOCATION_ID=

# --- Storage ----------------------------------------------------------------
DATABASE_URL=

# --- Slot signing -----------------------------------------------------------
# This is what stops the model inventing a time. Set it to a long random
# string in production; a rotated secret invalidates outstanding offers, which
# is the correct behaviour.
SLOT_SIGNING_SECRET=

# --- Behaviour --------------------------------------------------------------
DEFAULT_LOCATION_ID=
LOCATION_TIMEZONE=America/New_York
APPOINTMENT_MINUTES=60
SLOT_HOLD_SECONDS=180
BUSINESS_OPEN_HOUR=8
BUSINESS_CLOSE_HOUR=18
ONCALL_PHONE=

# --- Handoffs to n8n --------------------------------------------------------
N8N_ESCALATION_WEBHOOK_URL=
N8N_BOOKED_WEBHOOK_URL=

# --- The agent --------------------------------------------------------------
# Empty = demo rule-based mode (no LLM, no cost). Same tools + signed slots.
# Set to enable Claude: full agent in lib/agent/run.ts.
ANTHROPIC_API_KEY=
PRACTICE_NAME="Bright Smile Dental"

# Defaults to claude-opus-5. Server-side refusal fallbacks are always on.
AGENT_MODEL=

# Fast mode: ~2.5x output tokens/sec at premium pricing. Worth it on a live
# phone call, wasteful over WhatsApp. Opus 5 / 4.8 only.
AGENT_FAST_MODE=false
